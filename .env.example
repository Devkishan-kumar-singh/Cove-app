PORT=3000

# Firebase Admin service account encoded as a single base64 line.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Leave blank on the no-card Spark plan. Cloud Storage requires Blaze.
FIREBASE_STORAGE_BUCKET=

# Resend sends registration and login OTP emails.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Cove <login@your-verified-domain.com>
