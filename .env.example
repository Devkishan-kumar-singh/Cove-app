PORT=3000

# --- Gmail SMTP (for sending OTP emails) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your16charapppassword
EMAIL_FROM="Verify <your.email@gmail.com>"

# --- Supabase (database + file storage) ---
# Get these from your Supabase project: Settings -> Database (connection string)
# and Settings -> API (Project URL + service_role key).
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
